%% === Simple %MVC Bipolar Grid Plot: CON vs ECC ===
clear; clc; close all;

%% === Load Group Files ===
[mvc_file, mvc_path] = uigetfile('Group_MeanSingleRep_MVC.mat',  'Select MVC Group File');
[con_file, con_path] = uigetfile('Group_MeanSingleRep_CON75.mat','Select CON Group File');
[ecc_file, ecc_path] = uigetfile('Group_MeanSingleRep_ECC75.mat','Select ECC Group File');

if any([mvc_file, con_file, ecc_file] == 0)
    error('❌ One or more files not selected.');
end

MVC = load(fullfile(mvc_path, mvc_file));
CON = load(fullfile(con_path, con_file));
ECC = load(fullfile(ecc_path, ecc_file));

time = MVC.time_aligned;
Fs = MVC.Fs;

%% === Use Shortest Common Active Window ===
start_common = max([MVC.active_window(1), CON.active_window(1), ECC.active_window(1)]);
end_common   = min([MVC.active_window(2), CON.active_window(2), ECC.active_window(2)]);
active_window = [start_common, end_common];
if diff(active_window) <= 0
    error('❌ No overlapping active window found.');
end

%% === Channel Map (8x4) ===
ChMap = [1 16 17 32;
         2 15 18 31;
         3 14 19 30;
         4 13 20 29;
         5 12 21 28;
         6 11 22 27;
         7 10 23 26;
         8  9 24 25];

%% === Compute Bipolar RMS and Normalize ===
mvc_bipolar = compute_bipolar(MVC.emg_group_all(:,:,1), time, active_window, ChMap, Fs);
con_bipolar = compute_bipolar(CON.emg_group_all(:,:,1), time, active_window, ChMap, Fs);
ecc_bipolar = compute_bipolar(ECC.emg_group_all(:,:,1), time, active_window, ChMap, Fs);

% Normalize
con_norm = (con_bipolar ./ mvc_bipolar) * 100;
ecc_norm = (ecc_bipolar ./ mvc_bipolar) * 100;

% Reshape to 7x4 for plotting
con_map = reshape(con_norm, [7, 4]);
ecc_map = reshape(ecc_norm, [7, 4]);

disp('ECC Map values:');
disp(round(ecc_map, 1));

%% === Interpolated Grids with Single Shared Colorbar (0–100 %MVC) ===
figure('Color','w','Units','normalized','OuterPosition',[0 0 1 1]);
t = tiledlayout(1, 3, 'TileSpacing', 'compact', 'Padding', 'compact');

% Interpolation prep
[x, y] = meshgrid(1:4, 1:7);
[xq, yq] = meshgrid(1:0.05:4, 1:0.05:7);
con_interp = interp2(x, y, con_map, xq, yq, 'spline');
ecc_interp = interp2(x, y, ecc_map, xq, yq, 'spline');

% --- Use jet colormap, but apply nonlinear scaling to enhance low values ---
base_cmap = jet(256);
gamma = 0.4;  % adjust for contrast; <1 brightens low values
enhanced_cmap = base_cmap.^gamma;

% Set color limits to shared 0–100
clims = [0 100];

%% --- Compute Centroid of Activation Map (weighted by %MVC values)
[rows, cols] = size(con_map);
[x_c, y_c] = meshgrid(1:cols, 1:rows);  % same grid as con_map/ecc_map

% Centroid for CON
con_weights = con_map;
con_total = sum(con_weights(:));
x_centroid_con = sum(x_c(:) .* con_weights(:)) / con_total;
y_centroid_con = sum(y_c(:) .* con_weights(:)) / con_total;

% Centroid for ECC
ecc_weights = ecc_map;
ecc_total = sum(ecc_weights(:));
x_centroid_ecc = sum(x_c(:) .* ecc_weights(:)) / ecc_total;
y_centroid_ecc = sum(y_c(:) .* ecc_weights(:)) / ecc_total;

%% --- CON Plot
nexttile(1);
contourf(xq, yq, con_interp, 100, 'LineColor', 'none');
axis equal tight;
title('CON 75% MVC');
set(gca, 'XTick', [], 'YTick', [], 'YDir', 'normal');
box off;

% All overlays together
hold on;
for r = 1:6
    for c = 1:4
        plot(c, r + 0.5, 'ko', 'MarkerSize', 7, 'LineWidth', 1.2, 'MarkerFaceColor', 'none');
    end
end
plot(x_centroid_con, y_centroid_con, 'w+', 'MarkerSize', 15, 'LineWidth', 2);
hold off;

%% --- ECC Plot
nexttile(2);
contourf(xq, yq, ecc_interp, 100, 'LineColor', 'none');
axis equal tight;
title('ECC 75% MVC');
set(gca, 'XTick', [], 'YTick', [], 'YDir', 'normal');
box off;

% === Apply enhanced colormap globally and set color scale ===
colormap(enhanced_cmap);

% Ensure both subplots use the same caxis
nexttile(1); caxis(clims);
nexttile(2); caxis(clims);

% --- Add colorbar beside ECC
ax_ecc = nexttile(2);  % Get ECC tile axis
cb = colorbar(ax_ecc, 'Location', 'eastoutside');
cb.Label.String = '%MVC';
cb.Label.FontSize = 10;
cb.Ticks = 0:20:100;
cb.Limits = clims;

% === Overlay ECC Circles
hold on;
for r = 1:6  % only 6 bipolar positions vertically
    for c = 1:4
        plot(c, r + 0.5, 'ko', 'MarkerSize', 7, 'LineWidth', 1.2, 'MarkerFaceColor', 'none');
    end
end
hold off;

% ✅ Plot ECC centroid after hold on
plot(x_centroid_ecc, y_centroid_ecc, 'w+', 'MarkerSize', 15, 'LineWidth', 2);
hold off;
%% === Function: Compute Bipolar Signals ===
function bipolar = compute_bipolar(emg, time, window, ChMap, Fs)
    idx = time >= window(1) & time <= window(2);
    emg_active = emg(idx, :);  % [samples x 32]

    [nRows, nCols] = size(ChMap);
    bipolar = zeros((nRows - 1) * nCols, 1);  % 28 bipolar channels
    k = 1;
    for col = 1:nCols
        for row = 1:(nRows - 1)
            ch1 = ChMap(row, col);
            ch2 = ChMap(row + 1, col);
            diff_sig = emg_active(:, ch1) - emg_active(:, ch2);
            env = sqrt(Wfilt(diff_sig.^2, 100, 'low', Fs));
            bipolar(k) = mean(real(env), 'omitnan');
            k = k + 1;
        end
    end
end
