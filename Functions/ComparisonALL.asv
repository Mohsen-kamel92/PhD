%% === Compare CON vs ECC Group Conditions (Torque/Angle Absolute, EMG Normalized to MVC) ===
clear; clc; close all;

fprintf('🔁 Select the MVC Group Mean file:\n');
[mvcFile, mvcPath] = uigetfile('*_Group_MeanSingleRep.mat', 'Select Group MVC File');
if isequal(mvcFile, 0), return; end
mvcData = load(fullfile(mvcPath, mvcFile));

fprintf('🔁 Select the CON 75%% Group Mean file:\n');
[conFile, conPath] = uigetfile('*_Group_MeanSingleRep.mat', 'Select CON 75%% File');
if isequal(conFile, 0), return; end
conData = load(fullfile(conPath, conFile));

fprintf('🔁 Select the ECC 75%% Group Mean file:\n');
[eccFile, eccPath] = uigetfile('*_Group_MeanSingleRep.mat', 'Select ECC 75%% File');
if isequal(eccFile, 0), return; end
eccData = load(fullfile(eccPath, eccFile));

%% --- Normalize EMG to MVC
mvcEMGMax = max(mvcData.emg_group, [], 'omitnan');

% --- Absolute torque and angle (CON = as-is, ECC = flipped)
torque_con = conData.torque_group;
angle_con  = conData.angle_group;
torque_con_std = conData.torque_std;
angle_con_std  = conData.angle_std;

torque_ecc = flipud(eccData.torque_group);  % FLIPPED
angle_ecc  = flipud(eccData.angle_group);   % FLIPPED
torque_ecc_std = flipud(eccData.torque_std);
angle_ecc_std  = flipud(eccData.angle_std);

% --- Normalized EMG (%MVC, ECC flipped)
emg_con_norm = conData.emg_group / mvcEMGMax * 100;
emg_con_std  = conData.emg_std / mvcEMGMax * 100;

emg_ecc_norm = flipud(eccData.emg_group) / mvcEMGMax * 100;
emg_ecc_std  = flipud(eccData.emg_std) / mvcEMGMax * 100;

% Time vector (same for all)
time = conData.time_aligned;

% === Optional Smoothing (fix jagged lines creating double curves illusion)
smoothWin = 5;  % You can increase this for more smoothing

torque_con = smoothdata(torque_con, 'movmean', smoothWin);
torque_con_std = smoothdata(torque_con_std, 'movmean', smoothWin);
torque_ecc = smoothdata(torque_ecc, 'movmean', smoothWin);
torque_ecc_std = smoothdata(torque_ecc_std, 'movmean', smoothWin);

angle_con = smoothdata(angle_con, 'movmean', smoothWin);
angle_con_std = smoothdata(angle_con_std, 'movmean', smoothWin);
angle_ecc = smoothdata(angle_ecc, 'movmean', smoothWin);
angle_ecc_std = smoothdata(angle_ecc_std, 'movmean', smoothWin);

emg_con_norm = smoothdata(emg_con_norm, 'movmean', smoothWin);
emg_con_std  = smoothdata(emg_con_std, 'movmean', smoothWin);
emg_ecc_norm = smoothdata(emg_ecc_norm, 'movmean', smoothWin);
emg_ecc_std  = smoothdata(emg_ecc_std, 'movmean', smoothWin);

%% Before plotting:
sd_scale = 0.2;  % reduce visual spread to 30%
torque_con_std = torque_con_std * sd_scale;
torque_ecc_std = torque_ecc_std * sd_scale;

%% --- Plot
fig = figure('Color','w','Name','CON vs ECC: Absolute Torque & Angle, Normalized EMG', ...
             'Position',[100 100 800 700]);
tl = tiledlayout(3,1,'TileSpacing','compact','Padding','compact');

% Define custom colors that match your target image
c_short = [0.6 0.7 0.2];    % green-ish for shortening
c_length = [0.2 0.4 0.6];   % blue-ish for lengthening

% Lighter versions for fill (75% blend with white)
c_short_fill = c_short + (1 - c_short) * 0.75;
c_length_fill = c_length + (1 - c_length) * 0.75;

labels = {'CON','ECC'};

% === Helper Function for shaded error ===
shadedError = @(x, y, err, color) fill([x; flipud(x)], ...
                                       [y - err; flipud(y + err)], ...
                                       color, 'FaceAlpha', 0.4, 'EdgeColor','none');

% === 1. Torque ===
ax1 = nexttile; hold on;
shadedError(time, torque_con, torque_con_std, c_short_fill);
shadedError(time, torque_ecc, torque_ecc_std, c_length_fill);
p1 = plot(time, torque_con, 'Color', c_short, 'LineWidth', 2);
p2 = plot(time, torque_ecc, 'Color', c_length, 'LineWidth', 2);
ylabel('Torque (Nm)', 'FontWeight','bold');
title('CON vs. ECC Muscle Activity at Torque-Matched 75% MVC', 'FontWeight','bold');
set(ax1, 'XTickLabel', [], 'TickDir','out', 'Box','off');

% === 2. Crank Arm Angle ===
ax2 = nexttile; hold on;
shadedError(time, angle_con, angle_con_std, c_short_fill);
shadedError(time, angle_ecc, angle_ecc_std, c_length_fill);
plot(time, angle_con, 'Color', c_short, 'LineWidth', 2);
plot(time, angle_ecc, 'Color', c_length, 'LineWidth', 2);
ylabel('Crank Arm Angle (°)', 'FontWeight','bold');
set(ax2, 'XTickLabel', [], 'TickDir','out', 'Box','off');

% === 3. EMG ===
ax3 = nexttile; hold on;
shadedError(time, emg_con_norm, emg_con_std, c_short_fill);
shadedError(time, emg_ecc_norm, emg_ecc_std, c_length_fill);
plot(time, emg_con_norm, 'Color', c_short, 'LineWidth', 2);
plot(time, emg_ecc_norm, 'Color', c_length, 'LineWidth', 2);
ylabel('EMG RMS (%MVC)', 'FontWeight','bold');
xlabel('Time (s)', 'FontWeight','bold');
set(ax3, 'TickDir','out', 'Box','off');

% === Highlight overlapping active window ===
active_start = 0.516;
active_end   = 3.364;

% Set custom y-range for the dashed lines (used only in EMG subplot)
y_low = 0;
y_high = 20;

% Switch to EMG subplot to plot the dashed lines
axes(ax3);  % or nexttile(3); if preferred

% Plot short vertical dashed lines
h1 = line([active_start active_start], [y_low y_high], ...
    'LineStyle', '--', 'Color', 'k', 'LineWidth', 1);
h2 = line([active_end active_end], [y_low y_high], ...
    'LineStyle', '--', 'Color', 'k', 'LineWidth', 1);

% Set X ticks for all subplots
set([ax1, ax2, ax3], 'XTick', 1:floor(time(end)));

% Legend (on EMG subplot, including active window lines)
legend(ax3, [p1, p2, h1], {'CON', 'ECC', 'EMG-OverlapingWindow'}, ...
    'Location','northeast','Box','off');


%% --- Save
[saveName, saveDir] = uiputfile('Comparison_CON_ECC_AbsTorqueAngle_EMGnorm_Shaded.png', 'Save Comparison Plot');
if isequal(saveName, 0), return; end
saveas(fig, fullfile(saveDir, saveName));

fprintf('✅ Comparison plot with SD shading saved to:\n📍 %s\n', fullfile(saveDir, saveName));
