%% ===== ✅✅ PASSIVE TORQUE (use passive return only: 8–9.5s) + Residual baseline correction + SYNCED PLOT ===
close all; clear; clc;

%% --- Load synced file (EMG-timebase) ---
[file, path] = uigetfile('*_sync_rawVolts.mat', 'Select synchronized (EMG-timebase) file');
if isequal(file,0), return; end
S = load(fullfile(path, file));

% --- Participant and condition metadata (if present in file)
if isfield(S, 'participantName')
    participantName = S.participantName;
else
    participantName = 'Unknown';
end

if isfield(S, 'conditionName')
    conditionName = S.conditionName;
else
    conditionName = 'Unknown';
end

% --- Required fields
need = {'torque','angle','time'};
for k = 1:numel(need)
    if ~isfield(S, need{k})
        error('Missing "%s" in %s (not a synced export?).', need{k}, file);
    end
end

% --- Aliases (column vectors)
torque_i = S.torque(:);        % N·m (raw)
angle_i  = S.angle(:);         % deg
time     = S.time(:);          % s

% --- Optional fields (safe fallbacks)
Fs_emg  = []; emg = []; dac_on = []; aux_on = []; dt_ms = NaN;
if isfield(S,'Fs_emg'),  Fs_emg  = S.Fs_emg; end
if isfield(S,'emg'),     emg     = S.emg;    end
if isfield(S,'dac_on'),  dac_on  = S.dac_on; end
if isfield(S,'aux_on'),  aux_on  = S.aux_on; end
if ~isempty(dac_on) && ~isempty(aux_on)
    dt_ms = (dac_on(1) - aux_on(1))*1e3;
end

%% --- Basic Parameters and Pre-checks

% --- Ensure time is strictly increasing
if any(diff(time) <= 0)
    [time, ord] = sort(time);
    angle_i  = angle_i(ord);
    torque_i = torque_i(ord);

    if ~isempty(emg) && size(emg,1) == numel(ord)
        emg = emg(ord, :);  % Reorder EMG if matched
    end
end

% --- Sample time step
dt = median(diff(time));  % Typical EMG time resolution (s)
fc_torque = 20;
fc_angle = 6;  % [Hz] reasonable for slow movements

%% --- Passive Torque Subtraction using Custom Polyfit Method ---
fprintf('\n🔄 Running passive torque subtraction via Auto_RestTorque...\n');

% --- Define sampling frequency (from time)
Fs = 1 / median(diff(time));  % Sampling rate in Hz

% --- Define separate cutoffs
CutOff_torque = 20;  % Hz → for active torque smoothing
CutOff_angle  = 6;   % Hz → for joint angle smoothing

Order = 4;

% --- Design filters
[cuT, orderT] = Wcu(Order, CutOff_torque, 'low', Fs);
[bT, aT] = butter(orderT, cuT / (0.5 * Fs), 'low');

[cuA, orderA] = Wcu(Order, CutOff_angle, 'low', Fs);
[bA, aA] = butter(orderA, cuA / (0.5 * Fs), 'low');

% --- Apply zero-phase filtering
torque_filt = filtfilt(bT, aT, S.torque);   % 20 Hz
angle_filt  = filtfilt(bA, aA, S.angle);    % 6 Hz

% Passive fit based on your method
passive_p = Auto_RestTorque(torque_filt, angle_filt, Fs);
[tau_pass_hat, tau_active] = Normalize_Torque(torque_filt, angle_filt, passive_p);

% Store for later use
angle_smooth = angle_filt;
torque_i     = torque_filt;
fprintf('✅ Passive model applied via Normalize_Torque (custom fit).\n');

%% --- Define repetition start times from aux/dac signals (if available)
if ~isempty(aux_on)
    rep_starts = aux_on(:);  % Use aux signal onsets as rep starts
elseif ~isempty(dac_on)
    rep_starts = dac_on(:);  % Fallback to DAC onsets
else
    warning('No aux_on or dac_on markers found. Falling back to fixed 10s reps.');
    rep_duration = 10;
    rep_starts = 0 : rep_duration : floor(time(end) - rep_duration);
end

% Compute number of reps
nReps = numel(rep_starts);
fprintf('✅ Detected %d reps based on available trigger signals.\n', nReps);

%% --- Define fixed region for visualization (1.5–5.5 s after each rep start) ---
fixed_start_offset = 1.5;  % seconds
fixed_end_offset   = 5.5;  % seconds

fixed_windows = nan(nReps, 2);  % Preallocate

for i = 1:nReps
    t_start = rep_starts(i) + fixed_start_offset;
    t_end   = rep_starts(i) + fixed_end_offset;

    if t_end > time(end)
        fprintf('⚠️ Rep %d: Fixed window exceeds recording length. Skipping.\n', i);
        continue;
    end

    fixed_windows(i,:) = [t_start, t_end];
    fprintf('📌 Rep %d → Fixed window: %.2f–%.2f sec\n', i, t_start, t_end);
end
% Allocate cell arrays to store each rep separately
angle_fixed_all_cell  = cell(nReps,1);
torque_fixed_all_cell = cell(nReps,1);
emg_fixed_all_cell    = cell(nReps,1);
time_fixed_all_cell   = cell(nReps,1);

for i = 1:nReps
    % Define time mask for the fixed window
    mask = (time >= fixed_windows(i,1)) & (time <= fixed_windows(i,2));

    % Skip if not enough data points
    if sum(mask) < 5, continue; end

    % Store each rep
    angle_fixed_all_cell{i}  = angle_smooth(mask);
    torque_fixed_all_cell{i} = tau_active(mask);
    time_fixed_all_cell{i}   = time(mask);

    if ~isempty(emg)
        emg_fixed_all_cell{i} = emg(mask,:);  % matrix (samples × channels)
    end
end

% Determine max rep length
max_len = max(cellfun(@length, time_fixed_all_cell));

% Initialize 3D arrays
angle_fixed_all  = nan(max_len, nReps);
torque_fixed_all = nan(max_len, nReps);
time_fixed_all   = nan(max_len, nReps);
emg_fixed_all    = nan(max_len, size(emg,2), nReps);  % samples × channels × reps

for i = 1:nReps
    len = length(time_fixed_all_cell{i});
    angle_fixed_all(1:len, i)  = angle_fixed_all_cell{i};
    torque_fixed_all(1:len, i) = torque_fixed_all_cell{i};
    time_fixed_all(1:len, i)   = time_fixed_all_cell{i};

    if ~isempty(emg)
        emg_fixed_all(1:len,:,i) = emg_fixed_all_cell{i};
    end
end


%% --- Detect active rotation using angular velocity (smoothed angle)
% Assumes angle_smooth already computed

% --- Compute angular velocity (deg/s) using smoothed angle
angle_velocity = [0; diff(angle_smooth) ./ diff(time)];

velocity_thresh = 4;   % deg/s threshold to detect movement
min_duration = 0.1;      % Minimum movement duration (in seconds)
search_window = 6;       % Seconds to look after each rep start

active_windows = [];

for r = 1:nReps
    t0 = rep_starts(r);
    t1 = min(time(end), t0 + search_window);

    idx_rep = find(time >= t0 & time <= t1);
    if numel(idx_rep) < 2, continue; end

    time_r = time(idx_rep);
    vel_r  = angle_velocity(idx_rep);

    % Movement threshold mask (no pad_start / max_active_time used)
    above_thresh = abs(vel_r) > velocity_thresh;

    % Detect rising/falling edges
    d = diff([0; above_thresh; 0]);
    starts = find(d == 1);
    ends   = find(d == -1) - 1;

    found = false;
    for j = 1:numel(starts)
        t_start = time_r(starts(j));
        t_end   = time_r(ends(j));
        if (t_end - t_start) >= min_duration
            active_windows(end+1, :) = [t_start, t_end];
            fprintf('✅ Rep %d → Active window via velocity: %.2f to %.2f sec\n', r, t_start, t_end);
            found = true;
            break;  % Only use the first valid segment
        end
    end

    if ~found
        fprintf('⚠️ Rep %d → No valid movement segment detected\n', r);
    end
end

if isempty(active_windows)
    warning('🚫 No active windows were detected — check velocity threshold or trigger timing.');
else
    fprintf('✅ %d active windows detected.\n', size(active_windows, 1));
end


%% --- Loop over reps_Extract corrected active torque for each rep (using global passive model only)
tau_active_all = tau_active;  % Use the full corrected trace
mask_total_active = false(size(time));    % Track all active windows

for i = 1:size(active_windows, 1)
    t_start = active_windows(i,1);
    t_end   = active_windows(i,2);

    idx_active = (time >= t_start) & (time <= t_end);

    min_active_duration = 0.1;  % Minimum duration in seconds
if range(time(idx_active)) < min_active_duration
    fprintf('⚠️ Rep %d: active window too short (< %.1f s) — skipping\n', i, min_active_duration);
    continue;
end

    % Store the corrected tau_active (already computed earlier)
    tau_active_all(idx_active) = tau_active(idx_active);  % Corrected values

    % Update active mask
    mask_total_active = mask_total_active | idx_active;

    fprintf('✅ Rep %d: Active torque extracted (%.2f–%.2f s)\n', i, t_start, t_end);
end

%% === Optional: final smoothing just for display ===
smooth_ms = 15;  % ← Add this line
Nsm = max(1, round((smooth_ms/1000)/dt));  % e.g., 15 ms
tau_active_display = nan(size(tau_active_all));  % Preallocate
valid_idx = find(~isnan(tau_active_all));

if ~isempty(valid_idx)
    tau_valid = tau_active_all(valid_idx);
    % Filter only the valid part
    tau_filtered = real(Wfilt(tau_valid, fc_torque, 'low', Fs_emg));
    
    % Assign back
    tau_active_display(valid_idx) = tau_filtered;
else
    warning('⚠️ No valid active torque segments found for filtering.');
end


%% --- Compute EMG RMS envelope (if EMG exists)
emg_env_mean = [];

if ~isempty(emg) && ~isempty(Fs_emg) && isfinite(Fs_emg)
    fc_emg = 10;  % Hz – cutoff for EMG envelope (adjust as needed)
    emg_env = zeros(size(emg));  % Preallocate

    for ch = 1:size(emg, 2)
        emg_rect = emg(:, ch).^2;                       % Full-wave rectification
        emg_filt = Wfilt(emg_rect, fc_emg, 'low', Fs_emg);  % Low-pass filter
        emg_env(:, ch) = sqrt(emg_filt);                % RMS-like envelope
    end

    emg_env_mean = mean(emg_env, 2, 'omitnan');         % Average envelope across channels
end


%% --- Plot: Angle (top) + EMG (left) & Torque (right) ---

disp([length(time), length(tau_active_display)]);

tl = tiledlayout(2,1, ...
    'TileSpacing','compact', ...
    'Padding','compact', ...
    'OuterPosition', [0 0 1 0.96]);  % 🔼 Reduce vertical use to make space for title

% ---------- Top panel: ANGLE ----------
ax1 = nexttile(1);
hAng = plot(time, angle_smooth, 'Color',[0 0.55 0], 'LineWidth',1.8);
ylabel('Angle (°)','FontWeight','bold');
set(ax1,'XTickLabel',[],'XColor','none');

% ---------- Bottom panel EMG----------
ax2 = nexttile(2);

yyaxis left
hEMG = gobjects(0);  % placeholder
if ~isempty(emg_env_mean)
    hEMG = plot(time, emg_env_mean, 'r','LineWidth',1.8); hold on;
    rows = hEMG.DataTipTemplate.DataTipRows;
    iy = find(strcmp({rows.Label}, 'Y'), 1);
    if ~isempty(iy)
        rows(iy) = dataTipTextRow('EMG RMS (mV)', hEMG.YData*1e3);
        hEMG.DataTipTemplate.DataTipRows = rows;
    end
end
ylabel('EMG RMS (mV)','FontWeight','bold');
ylim([0 0.0025]);
set(ax2,'YTick',0:0.0005:0.0025,'YTickLabel',0:0.5:2.5);

%-----------Bottom panel Torque Nm--------

if any(isnan(tau_active_display)) || any(~isfinite(tau_active_display)) ...
   || length(tau_active_display) ~= length(time)
   warning('⚠️ Inconsistent or NaN values in torque data — skipping torque plot.');
end

yyaxis right
hTQ = plot(time, tau_active_display, 'Color',[0.5 0 0.5],'LineWidth',1.8);
ylabel('Torque (Nm)','FontWeight','bold');

%------Color of X axis----------

ax2.YAxis(1).Color = [1 0 0];        % EMG axis red
ax2.YAxis(2).Color = [0.5 0 0.5];    % Torque axis purple

% Set Y ticks for torque to include 0 and use ±10 steps
yl = ylim(ax2);  % Current limits
yl_new = [floor(yl(1)/10)*10, ceil(yl(2)/10)*10];  % Round to nearest 10
ylim(ax2, yl_new);  % Apply new limits

yt = yl_new(1):10:yl_new(2);  % Tick every 10 Nm
ax2.YAxis(2).TickValues = yt;


% X axis (time)
xlabel('Time (s)','FontWeight','bold');
linkaxes([ax1,ax2],'x');

tick_step = (time(end) < 15) * 1 + (time(end) >= 15) * 10;
set(ax2,'XTick',tick_step:tick_step:floor(time(end)));


%% ---------- Shared title ----------

title(ax1, ...
    sprintf('ECC\\_90%% Active Torque (Passive Contribution Removed)'), ...
    'FontWeight', 'bold', ...
    'FontSize', 14, ...
    'Units', 'normalized', ...
    'Position', [0.5, 1.08, 0]);  % 🔼 Adjust upward position

%% ---------- Clean styling ----------
set(gcf,'Color','w');
set([ax1,ax2], 'Color','w','XGrid','off','YGrid','off','Box','off', ...
    'TickDir','out','FontWeight','bold','FontSize',12,'LineWidth',1.2);


%% --- Add a dashed black rectangle + shaded region for active windows ---
yyaxis right           % Ensure we're on the correct axis
yLimits = ylim(ax2);   % Get current Y-axis limits
axes(ax2); hold on;

for i = 1:size(active_windows, 1)
    t_start = active_windows(i,1);
    t_end   = active_windows(i,2);

    if isnan(t_start) || isnan(t_end) || t_end <= t_start
        continue;
    end

    % Draw dashed rectangle for active window
    rectangle('Position', [t_start, yLimits(1), t_end - t_start, diff(yLimits)], ...
              'EdgeColor', 'k', 'LineStyle', '--', 'LineWidth', 1);

    % Shaded region (fill full active window)
    fill([t_start t_end t_end t_start], ...
         [yLimits(1) yLimits(1) yLimits(2) yLimits(2)], ...
         [0.85 0.95 1], 'EdgeColor', 'none', 'FaceAlpha', 0.35, 'Parent', ax2);
end


% ---------- Legend ----------
legend_items = [];
legend_labels = {};

% Angle
if exist('hAng','var') && isgraphics(hAng)
    legend_items(end+1) = hAng;
    legend_labels{end+1} = 'Angle';
end

% Torque
if exist('hTQ','var') && isgraphics(hTQ)
    legend_items(end+1) = hTQ;
    legend_labels{end+1} = 'Torque';
end

% EMG
if exist('hEMG','var') && isgraphics(hEMG)
    legend_items(end+1) = hEMG;
    legend_labels{end+1} = 'EMG RMS';
end

% Dummy line for 'Active movement window'
hRectDummy = plot(nan, nan, 'k--', 'LineWidth', 1.2);
legend_items(end+1) = hRectDummy;
legend_labels{end+1} = 'Active rotation';

% Dummy shaded fill
hFillDummy = fill(nan, nan, [0.85 0.95 1], 'EdgeColor', 'none', 'FaceAlpha', 0.35);
legend_items(end+1) = hFillDummy;
legend_labels{end+1} = 'Active torque';

legend(ax2, legend_items, legend_labels, ...
    'Location', 'best', 'Box', 'off', 'FontSize', 7);
legendHandle = legend(ax2);
legendHandle.ItemTokenSize = [10, 10];


%% --- Save corrected trial with matched active torque
time_matched       = time_matched_all;
angle_matched      = angle_matched_all;
torque_matched     = torque_matched_all;
emg_raw_matched    = emg_matched_all;  % ⬅️ Synchronized raw EMG to 90% active torque

% Meta
torque_corrected   = tau_active_display;  % Full filtered active torque trace
angle              = angle_smooth;        % Full smoothed angle trace
time               = time;                % Full time vector
dt_align           = dt_ms / 1000;
method             = 'Passive fit + baseline correction + 90% central torque-EMG sync';
emg_raw            = emg;  % Full original EMG (unsliced)

if ~exist('participantName','var'), participantName = "Unknown"; end
if ~exist('conditionName','var'),  conditionName  = "Unknown";  end
if isfield(S,'aux_on'), aux_on = S.aux_on; else, aux_on = []; end
if isfield(S,'dac_on'), dac_on = S.dac_on; else, dac_on = []; end

saveName = sprintf('%s_%s_ActiveTorqueCorrected.mat', ...
                   string(participantName), string(conditionName));
savePath = fullfile(path, saveName);

save(savePath, ...
    'participantName','conditionName','Fs_emg','dt_align','method', ...
    'time','angle','torque_corrected','emg_raw', ...
    'time_matched','angle_matched','torque_matched','emg_raw_matched', ...
    'active_windows','fixed_windows','time_fixed_all','angle_fixed_all','torque_fixed_all','emg_fixed_all','aux_on','dac_on');

fprintf('✅ Saved corrected trial: %s\n', saveName);


