%% ===== ✅✅Interpolate SPIKE Torque/Angle to EMG & Check DAC1 vs AUX Sync ===== % Starts acode section aka which could be run independently
close all; clear; clc;  % Close all open figures, Clear and remove variables old loaded variables, clc the command window

%% --- Load SPIKE .mat (expects fields: DAC1, Torque, Angle with .times/.values) ---
[SpikeFile, pathFile] = uigetfile('*.mat','Pick SPIKE mat file','MultiSelect','off'); % Storing the variable name (spikefile) and its path (pathfile)
if isequal(SpikeFile,0), return; end  %if the user cancels the dialog (uigetfile), bail out
S = load(fullfile(pathFile, SpikeFile)); % S is the variable that receives the loaded data. Load=loads data inside the .mat file according the the current (My OS) Whereas, fullfile chooses the approperiate path according to my OS
% S is a struct field that variables saved in
mustHave = {'DAC1','Torque','Angle'}; %curly braces=cell of a list of strings (sequence of letters). In that case the mustHave checks 1×3 cell array of field names required
for k = 1:numel(mustHave)
    if ~isfield(S, mustHave{k})
        error('Missing "%s" in SPIKE file.', mustHave{k});
    end
end %logic: guarantee the file conatains at least DAC1, Torque, and Angle

% Cut SPIKE by DAC1 > 0.85 (first to last)
th_dac = 0.85;
dac_times  = S.DAC1.times(:);
dac_values = S.DAC1.values(:); %Identify the continuous block where DAC1 is high based on a tome vs value stamp
i1 = find(dac_values > th_dac, 1, 'first');
i2 = find(dac_values > th_dac, 1, 'last');
if isempty(i1) || isempty(i2) || i2 <= i1
    error('Could not find a valid high segment in DAC1 using threshold %.2f.', th_dac);
end % Logic: Define a single continuous active window for all Spike channels

% Apply same cut to all SPIKE channels with .times/.values; re-zero time
SPIKE_vars = fieldnames(S); % Make a list of names inside S, like DAC1, Torque...etc
for i = 1:numel(SPIKE_vars) %loop through that list one name at a time and and store in fn
    fn = SPIKE_vars{i}; % recall,,use the curly braces to get the string inside the cell
    if isstruct(S.(fn)) && isfield(S.(fn),'times') && isfield(S.(fn),'values') % here it tells matlab to only proceed if S.(fn) has the field of imes and values
        S.(fn).times  = S.(fn).times(i1:i2); %Crop the time window from the first detected point above ths to the second point above ths
        S.(fn).values = S.(fn).values(i1:i2); %Do the same for the values
        S.(fn).times  = S.(fn).times - S.(fn).times(1);% rezero the time stamp to start from zero, so subtracting new first time stamp from all the time stamps
    end
end
% Frequency from DAC1 if available
if isfield(S.DAC1,'interval'), F_Spike = 1 / S.DAC1.interval;
elseif isfield(S.Torque,'interval'), F_Spike = 1 / S.Torque.interval; %Here we use the interval time between neighboring samples, so 1/fs = how many samples per second, and Fs = 1/△t (interval), at the end means fs = N sample per time
else, F_Spike = NaN; end % The function loop into the S.Torque and S.DAC1, and if unknown

%% --- Load MAECS (HDEMG) and cut by AUX > 0 ---
F_maecs = 2048;               % if you know the exact EMG Fs; adjust if needed
HDEMG   = MAECS_read();       % select .sig.. A function lives in a separate file inside the MAECS toolbox folder that came with installation

% Enforce single-grid assumption (no logic change downstream)
gNames = fieldnames(HDEMG);
assert(numel(gNames) == 1, 'Expected exactly one grid, found %d.', numel(gNames));
gridName = gNames{1};

% Keep your original AUX check
if ~isfield(HDEMG.(gridName), 'AUX')
    error('AUX not found in HDEMG.%s', gridName);
end

% --- Resolve time vector (allow 'Times' or 'time') ---
if     isfield(HDEMG.(gridName), 'Times')
    tE = HDEMG.(gridName).Times(:);
elseif isfield(HDEMG.(gridName), 'time')
    tE = HDEMG.(gridName).time(:);
else
    error('No time vector found in HDEMG.%s (expected Times or time).', gridName);
end

% --- Read AUX and EMG; basic shape checks ---
aux = HDEMG.(gridName).AUX(:);
emg = HDEMG.(gridName).EMG;   % [samples x channels] expected

assert(numel(aux) == numel(tE), ...
    'AUX length (%d) must match time length (%d).', numel(aux), numel(tE));
assert(size(emg,1) == numel(tE), ...
    'EMG rows (%d) must match time length (%d).', size(emg,1), numel(tE));

% --- Clean AUX (treat NaN/Inf as low) ---
bad = ~isfinite(aux);  %flags samples that are NaN, +Inf, or -Inf. Those are invalid numbers that can break thresholding (aux > 0) or create fake highs.
if any(bad), aux(bad) = 0; end

% --- Find cut window where AUX > 0 (first to last) ---
j1 = find(aux > 0, 1, 'first');
j2 = find(aux > 0, 1, 'last');
if isempty(j1) || isempty(j2) || j2 <= j1
    error('Could not find a valid high segment in AUX (need AUX>0 span).');
end

% --- Apply cut and re-zero time ---
emg_vals = emg(j1:j2, :);
emg_time = tE(j1:j2);
emg_time = emg_time - emg_time(1);
AUX_cut  = aux(j1:j2);


%% --- Align by onset (DAC1 vs AUX), interpolate SPIKE -> EMG, crop tail ---

% 1) Onset times on native streams
tA0 = emg_time( find(AUX_cut > 0,     1, 'first') );          % AUX onset (EMG side)
tD0 = S.DAC1.times( find(S.DAC1.values > 0.85, 1, 'first') ); % DAC1 onset (SPIKE side)

% 2) Constant offset (DAC relative to AUX); shift SPIKE time axes by -dt
dt = tD0 - tA0;                          % +dt = DAC lags AUX
tTorque = S.Torque.times - dt;
tAngle  = S.Angle.times  - dt;
tDAC    = S.DAC1.times   - dt;

% 3) Interpolate SPIKE -> EMG timebase (NO extrapolation)
torque_i = interp1(tTorque, S.Torque.values, emg_time, 'linear');
angle_i  = interp1(tAngle,  S.Angle.values,  emg_time, 'linear');
dac1_i   = interp1(tDAC,    S.DAC1.values,   emg_time, 'linear');

% --- Define DAC threshold early ---
thr_dac_plot = 0.85;  % same as used later in plotting

% --- Pre-cropping onsets from aligned signals ---
aux_on_all = emg_time( find(diff(AUX_cut > 0) == 1) + 1 );
dac_on_all = emg_time( find(diff(dac1_i  > thr_dac_plot) == 1) + 1 );


% 4) Keep ONLY the common valid overlap (crop EMG tail so lengths match)
valid = isfinite(torque_i) & isfinite(angle_i) & isfinite(dac1_i);
firstIdx = find(valid,1,'first');
lastIdx  = find(valid,1,'last');
keep = firstIdx:lastIdx;

% --- Keep only onsets inside final time window ---
aux_on = aux_on_all(aux_on_all >= emg_time(keep(1)) & aux_on_all <= emg_time(keep(end)));
dac_on = dac_on_all(dac_on_all >= emg_time(keep(1)) & dac_on_all <= emg_time(keep(end)));

time      = emg_time(keep);      % unified timeline (cropped)
emg_vals  = emg_vals(keep,:);    % EMG cropped to overlap
AUX_cut   = AUX_cut(keep);       % crop AUX too
torque_i  = torque_i(keep);
angle_i   = angle_i(keep);
dac1_i    = dac1_i(keep);

% (Optional) quick printout
fprintf('Onset offset dt = %.3f ms; kept %.3f s of overlap.\n', dt*1e3, time(end)-time(1));

%% --- Compute onsets on the CROPPED timeline (for plotting) ---
thr_dac_plot = 0.85;                                % same DAC1 threshold you used
tA0  = time( find(AUX_cut > 0,               1, 'first') );
tD0  = time( find(dac1_i  > thr_dac_plot,    1, 'first') );
dt_ms = (tD0 - tA0) * 1e3;                         % may be 0.00 ms, dt*1e3 = convert from seconds → milliseconds (dt × 1000).

% DAC1 onsets: assume first onset is start of DAC1 signal
dac_on = [time(1); time( find(diff(dac1_i > thr_dac_plot) == 1) + 1 )];

% AUX onsets: assume first onset is start of EMG
aux_on = [time(1); time( find(diff(AUX_cut > 0) == 1) + 1 )];

% Safety fallbacks
if isempty(dac_on), dac_on = time(1); end
if isempty(aux_on), aux_on = time(1); end


% Alignment + interpolation: step summary ---
% 1) Onsets on native streams:
%    tA0 = first(AUX_cut > 0) on EMG;  tD0 = first(DAC1 > 0.85) on SPIKE.
%
% 2) Constant offset and shift SPIKE clocks:
%    dt = tD0 - tA0   (dt>0 ⇒ DAC lags).  Shift SPIKE times by -dt so all align to EMG.
%
% 3) Interpolate SPIKE → EMG timebase (NO extrapolation):
%    torque_i = interp1(tTorque, S.Torque.values, emg_time, 'linear');
%    angle_i  = interp1(tAngle,  S.Angle.values,  emg_time, 'linear');
%    dac1_i   = interp1(tDAC,    S.DAC1.values,   emg_time, 'linear');
%    → Returns NaN outside overlap (since no 'extrap' used).
%
%    Interpolation TYPE: 1-D piecewise-LINEAR.
%      Given two known samples (t_k, y_k) and (t_{k+1}, y_{k+1}),
%      for any query t_q with t_k ≤ t_q ≤ t_{k+1}:
%          y(t_q) = y_k + (y_{k+1}-y_k) * (t_q - t_k) / (t_{k+1}-t_k)
%      (Applied independently per channel/column.)
%
% 4) Keep only common overlap:
%    Find first/last indices where all interpolated series are finite; crop time/EMG/AUX/SPIKE to that span.
%
% 5) Recompute onsets on the CROPPED timeline (for plotting + Δt in ms):
%    tA0 = first(AUX_cut > 0);  tD0 = first(dac1_i > 0.85);  dt_ms = (tD0 - tA0)*1e3.
%    Also get all rising edges via diff(cond)==1 for vertical markers.
%
% Notes:
%  - tTorque/tAngle/tDAC must be monotonic and same length as their values.
%  - If needed: [t,ord] = sort(t);  y = y(ord);  (then call interp1).

%% --- After interpolation & cropping ---
time      = emg_time(keep);
emg_vals  = emg_vals(keep,:);   % <-- now EMG data is final and cropped
torque_i  = torque_i(keep);
angle_i   = angle_i(keep);
dac1_i    = dac1_i(keep);
AUX_cut   = AUX_cut(keep);

%% --- Apply Wfilt smoothing to angle and torque for visualization ---
Fs = F_maecs;
fc_angle  = 10;  % Hz cutoff for angle smoothing
fc_torque = 10;  % Hz cutoff for torque smoothing

angle_smooth  = Wfilt(angle_i(keep),  fc_angle,  'low', Fs);  % Smoothed angle
torque_smooth = Wfilt(torque_i(keep), fc_torque, 'low', Fs);  % Smoothed torque


%% >>> INSERT ENVELOPE CALCULATION HERE (RMS) <<<
Fs = F_maecs;                      % EMG sampling rate (e.g., 2048 Hz)
win_sec = 0.020;                   % 20 ms window
win = ceil(win_sec*Fs);   % seconds -> samples (ensure >=1) ceil = round up

% RMS envelope per channel (centered window; edges use shorter windows)
emg_env = sqrt(movmean(emg_vals.^2, win, 1, 'Endpoints','shrink'));   % [N x channels] 

% Across-channel summaries (one trace + variability band)
emg_env_mean = mean(emg_env, 2);           % [N x 1]
p10          = prctile(emg_env, 10, 2);    % [N x 1]
p90          = prctile(emg_env, 90, 2);    % [N x 1]

% RMS envelope (why & how):
% 1) Pick a window in seconds and convert to samples:
%      win = ceil(win_sec*Fs);   % e.g., ~20 ms -> ~41 samples at 2048 Hz
% 2) Square EMG element-wise: emg_vals.^2
%      – makes all values non-negative and weights larger bursts more (power).
% 3) Centered moving mean along time (dim=1):
%      movmean(..., win, 1, 'Endpoints','shrink') averages the current sample
%      plus ~win/2 neighbors on each side; at the start/end it uses shorter windows
%      (no zero-padding).
% 4) Square-root the local mean of squares:
%      sqrt(...) brings units back to amplitude (V or µV) → RMS envelope.
%
% If you prefer MAV instead of RMS, use: movmean(abs(emg_vals), win, 1, 'Endpoints','shrink')

% --- Then continue with plotting ---

%% --- Plot: Angle (top) + EMG (left) & Torque (right) bottom; shared x-axis ---
tl = tiledlayout(2,1,'TileSpacing','compact','Padding','compact');

% ---------- Top panel: ANGLE ----------
ax1 = nexttile(1);
hAng = plot(time, angle_smooth, 'Color',[0 0.55 0], 'LineWidth',1.8); hold on;   % thicker
hDAC1 = []; hAUX1 = [];
if ~isempty(dac_on)
    hDAC1 = xline(ax1, dac_on(1),'--k','LineWidth',1.2,'HandleVisibility','on');
    arrayfun(@(x) xline(ax1, x,'--k','LineWidth',1.2,'HandleVisibility','off'), dac_on(2:end));
end

if ~isempty(aux_on)
    hAUX1 = xline(aux_on(1),'--','Color',[1 0 1],'LineWidth',1.2,'HandleVisibility','on');
    arrayfun(@(x) xline(x,'--','Color',[1 0 1],'LineWidth',1.2,'HandleVisibility','off'), aux_on(2:end));
end
ylabel('Angle (°)','FontWeight','bold');                            % BOLD LABEL
set(ax1,'XTickLabel',[],'XColor','none');

% ---------- Bottom panel: EMG (left) + Torque (right) ----------
ax2 = nexttile(2);

yyaxis left
hold on
hEMG = plot(time, emg_env_mean, 'r', 'LineWidth', 1.8);


% --- Datatip: show EMG in mV (not V) ---
rows = hEMG.DataTipTemplate.DataTipRows;               % current rows (usually X, Y)
iy = find(strcmp({rows.Label}, 'Y'), 1);               % locate the Y row
if ~isempty(iy)
    rows(iy) = dataTipTextRow('EMG RMS (mV)', hEMG.YData*1e3);
    hEMG.DataTipTemplate.DataTipRows = rows;
end


% ----- Force EMG axis in mV (0–2.5 mV, 6 ticks) -----
yt = 0:0.0005:0.0025;                       % tick positions in volts
set(ax2,'YTick',yt,'YTickLabel',0:0.5:2.5);
ylim([0 0.0025]);                           % 0–2.5 mV fixed
ylabel('EMG RMS (mV)','FontWeight','bold');

%% -----------Right Torque plotting
yyaxis right
hTQ  = plot(time, torque_smooth, 'Color',[0.5 0 0.5], 'LineWidth',1.8);  % SMOOTHED trace
ylabel('Torque (Nm)', 'FontWeight', 'bold');

% Match axis colors to trace colors
ax2.YAxis(1).Color = [1 0 0];        % left axis (EMG) → red
ax2.YAxis(2).Color = [0.5 0 0.5];    % right axis (Torque) → purple

xlabel('Time (s)','FontWeight','bold');                                    % BOLD LABEL

%% Extended onset markers in bottom panel too (legend handled via proxies)
yyaxis left
if ~isempty(dac_on)
    arrayfun(@(x) xline(ax2,x,'--','Color',[0 0 0],'LineWidth',1.2,'HandleVisibility','off'), dac_on);
end
if ~isempty(aux_on)
    arrayfun(@(x) xline(ax2,x,'--','Color',[1 0 1],'LineWidth',1.2,'HandleVisibility','off'), aux_on);
end

%% ---------- Shared title ----------
%sgtitle(sprintf('MVC %% Trigger Alignment (DAC1 - AUX = %.2f ms)', dt_ms), 'FontWeight','bold');

%sgtitle(sprintf('ECC\\_75%% Trigger Alignment (DAC1 - AUX = %.2f ms)', dt_ms), 'FontWeight','bold');
%sgtitle(sprintf('ECC\\_90%% Trigger Alignment (DAC1 - AUX = %.2f ms)', dt_ms), 'FontWeight','bold');

%sgtitle(sprintf('CON\\_75%% Trigger Alignment (DAC1 - AUX = %.2f ms)', dt_ms), 'FontWeight','bold');
%sgtitle(sprintf('CON\\_90%% Trigger Alignment (DAC1 - AUX = %.2f ms)', dt_ms), 'FontWeight','bold');
% Link x-axes

linkaxes([ax1,ax2],'x');

%% ---------- Adaptive x-axis ticks ----------
if time(end) < 15
    tick_step = 1;                     % short trial (MVC) → ticks every 1 s
else
    tick_step = 10;                    % long trial (multi-rep) → ticks every 10 s
end
set(ax2,'XTick',tick_step:tick_step:floor(time(end)));
xlabel('Time (s)','FontWeight','bold');


%% ---------- Clean styling ----------
set(gcf,'Color','w');
set([ax1,ax2], 'Color','w', 'XGrid','off','YGrid','off','Box','off', ...
               'TickDir','out', 'FontWeight','bold','FontSize',12, 'LineWidth',1.2);  % BOLD TICKS + SIZE

% ---------- Legend on ax2 (fix: don't pass tiledlayout). Use proxy lines. ----------
% Proxies so legend shows all items regardless of which axes they live on:
hAngProxy = plot(ax2, NaN,NaN, '-',  'Color',[0 0.55 0], 'LineWidth',1.8, 'HandleVisibility','on'); % Angle
hDACproxy = plot(ax2, NaN,NaN, '--', 'Color',[0 0 0],    'LineWidth',1.2, 'HandleVisibility','on'); % DAC1 
hAUXproxy = plot(ax2, NaN,NaN, '--', 'Color',[1 0 1],    'LineWidth',1.2, 'HandleVisibility','on'); % Aux


% ----------Last legend

lgdHandles = [hAngProxy hTQ hEMG hDACproxy hAUXproxy];  % Now 5 items
lgdLabels  = {'Angle','Torque','EMG','DAC','AUX'};      % Matching 5 labels
lgd = legend(ax2, lgdHandles, lgdLabels, ...
             'Location', 'best', ...
             'Box', 'off', ...
             'FontSize', 8);  % Optional: reduce font size
% Optional tweaks for even tighter legend box:
lgd.ItemTokenSize = [8, 4];         % 🔻 reduce icon size
lgd.NumColumns = 1;                 % 🔁 set columns if too wide

%% --- Save synchronized data (aligned to EMG timebase, cropped to overlap) ---

torque   = torque_i;        % aligned & cropped
angle    = angle_i;         % aligned & cropped
dac1     = dac1_i;          % aligned & cropped
emg      = emg_vals;        % raw EMG (volts), cropped to overlap
AUX      = AUX_cut;         % cropped
%time     = time;            % EMG timebase (seconds), cropped

% Meta
Fs_emg   = F_maecs;         % 2048 Hz (EMG timebase)
Fs_spike = F_Spike;         % original SPIKE nominal rate (if known)
dt_align = dt;              % DAC1-AUX onset offset used (seconds)
thr_dac  = 0.85;            % threshold used for DAC1 high
method   = 'onset-shift + interp-to-EMG + crop-overlap (no extrap)';
% Example: pathFile = "...\MainFolder\AnnaM\CON_75\"
% Example: SpikeFile = "CON_75_Final.mat"

[~, conditionFolder]    = fileparts(pathFile(1:end-1));   % e.g. "CON_75"
[parentPath, ~]         = fileparts(pathFile(1:end-1));   % e.g. ...\MainFolder\AnnaM
[~, participantFolder]  = fileparts(parentPath);          % e.g. "AnnaM"

participantName = participantFolder;
conditionName   = conditionFolder;

% --- Save file with both
outname = fullfile(pathFile, sprintf('%s_%s_sync_rawVolts.mat', ...
                                     participantName, conditionName));
save(outname, 'torque','angle','dac1','emg','AUX','time', ...
              'Fs_emg','Fs_spike','dt_align','thr_dac','method', ...
              'participantName','conditionName', ...
              'aux_on','dac_on');  % ✅ Add these two


fprintf('✅ Saved synchronized data to: %s\n', outname);



