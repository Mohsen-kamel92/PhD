%% === Group Mean from Multiple Participant Median Files ===
clear; clc; close all;
maxParticipants = 9;

% --- Manually select up to maxParticipants files one-by-one
files = cell(1, maxParticipants);
fprintf('📥 Please select up to %d participant files one-by-one:\n', maxParticipants);
for i = 1:maxParticipants
    [file, folder] = uigetfile('*_MedianSingleRep.mat', ...
        sprintf('Select file %d of %d (Cancel to stop)', i, maxParticipants));
    if isequal(file, 0)
        files = files(1:i-1);  % Trim unused slots
        break;
    end
    files{i} = fullfile(folder, file);
end

if isempty(files)
    error('❌ No files selected.');
end
fprintf('📁 %d files selected manually.\n', numel(files));

% --- Load and process data from each participant
for i = 1:numel(files)
    S = load(files{i});

    % --- Get EMG data field safely
    if isfield(S, 'emg_median')
        emg_data = S.emg_median;
    elseif isfield(S, 'emg_env_mean')
        emg_data = S.emg_env_mean;
    else
        error('❌ No valid EMG data found in %s', files{i});
    end

    if i == 1
        time_aligned = S.time_aligned;
        Fs = S.Fs;
        n = length(time_aligned);
        [nSamples, nChannels] = size(emg_data);

        torque_all     = nan(n, numel(files));
        angle_all      = nan(n, numel(files));
        emg_group_all  = nan(n, nChannels, numel(files));
    end

    torque_all(:, i) = S.torque_median;
    angle_all(:, i)  = S.angle_median;

    % Process EMG (rectify, filter, sqrt)
    fc_emg = 100;
    emg_env = zeros(nSamples, nChannels);
    for ch = 1:nChannels
        emg_rect = emg_data(:, ch).^2;
        emg_filt = Wfilt(emg_rect, fc_emg, 'low', Fs);
        emg_env(:, ch) = sqrt(emg_filt);
    end
    emg_group_all(:, :, i) = emg_env;
end

%% --- Group Mean Waveforms (per timepoint across participants)
torque_group = mean(torque_all, 2, 'omitnan');
angle_group  = mean(angle_all,  2, 'omitnan');
emg_group    = mean(mean(emg_group_all, 2, 'omitnan'), 3, 'omitnan');  % [n x 1]

% --- SD for shading (across participants)
torque_std = std(torque_all, 0, 2, 'omitnan');
angle_std  = std(angle_all,  0, 2, 'omitnan');
emg_std    = std(mean(emg_group_all, 2, 'omitnan'), 0, 3, 'omitnan');

%% --- Mean ± SD (across time of group-averaged waveform)
group_torque_m = mean(torque_group, 'omitnan');
group_torque_s = std(torque_group,  'omitnan');

group_angle_m  = mean(angle_group,  'omitnan');
group_angle_s  = std(angle_group,   'omitnan');

group_emg_m    = mean(emg_group,    'omitnan') * 1e3;  % mV
group_emg_s    = std(emg_group,     'omitnan') * 1e3;  % mV

%% --- Detect active region using angular velocity
angular_velocity = [0; diff(angle_group) ./ diff(time_aligned)];
thresh = 4; min_duration = 0.1;

above = abs(angular_velocity) > thresh;
d = diff([0; above; 0]);
starts = find(d == 1);
ends = find(d == -1) - 1;

active_window = [NaN, NaN];
for j = 1:length(starts)
    t0 = time_aligned(starts(j));
    t1 = time_aligned(ends(j));
    if (t1 - t0) >= min_duration
        active_window = [t0, t1];
        break;
    end
end

%% --- PLOT
fig = figure('Color','w','Name','Group Mean Rep','Position',[100 100 800 600]);
tl = tiledlayout(3,1,'TileSpacing','compact','Padding','compact');

% Torque
ax1 = nexttile;
hold on;
fill(ax1, [time_aligned; flipud(time_aligned)], ...
    [torque_group - torque_std; flipud(torque_group + torque_std)], ...
    [0.5 0 0.8], 'FaceAlpha', 0.2, 'EdgeColor', 'none');
plot(time_aligned, torque_group, 'LineWidth', 2, 'Color', [0.5 0 0.8]);
ylabel('Torque (Nm)','FontWeight','bold');
title('Group-Level Mean Rep','FontWeight','bold');
set(ax1, 'XTickLabel', [], 'TickDir','out', 'Box','off');

% Angle
ax2 = nexttile;
hold on;
fill(ax2, [time_aligned; flipud(time_aligned)], ...
    [angle_group - angle_std; flipud(angle_group + angle_std)], ...
    [0 0.5 0], 'FaceAlpha', 0.2, 'EdgeColor', 'none');
plot(time_aligned, angle_group, 'LineWidth', 2, 'Color', [0 0.5 0]);
ylabel('Crank Arm Angle (°)','FontWeight','bold');
set(ax2, 'XTickLabel', [], 'TickDir','out', 'Box','off');

% EMG
ax3 = nexttile;
hold on;
fill(ax3, [time_aligned; flipud(time_aligned)], ...
    [(emg_group - emg_std)*1e3; flipud((emg_group + emg_std)*1e3)], ...
    [1 0 0], 'FaceAlpha', 0.2, 'EdgeColor', 'none');
plot(time_aligned, emg_group * 1e3, 'LineWidth', 2, 'Color', [1 0 0]);
ylabel('EMG RMS (mV)','FontWeight','bold');
xlabel('Time (s)','FontWeight','bold');
set(ax3, 'TickDir','out','Box','off');

% Active movement shading
if ~any(isnan(active_window))
    for ax = [ax1, ax2, ax3]
        yl = ylim(ax);
        fill(ax, [active_window fliplr(active_window)], ...
            [yl(1) yl(1) yl(2) yl(2)], [0.9 0.9 1], ...
            'EdgeColor', 'none', 'FaceAlpha', 0.3);
    end
    fprintf('✅ Active movement window: %.2f to %.2f s\n', active_window);
else
    warning('⚠️ No active movement window detected.');
end

% Legend
axL = axes('Position', [0, 0, 1, 1], 'Visible', 'off'); hold(axL, 'on');
hT = plot(axL, NaN, NaN, 'Color', [0.5 0 0.8], 'LineWidth', 2);
hA = plot(axL, NaN, NaN, 'Color', [0 0.5 0], 'LineWidth', 2);
hE = plot(axL, NaN, NaN, 'Color', [1 0 0], 'LineWidth', 2);

legend(ax3, [hT, hA, hE], {'Torque', 'Angle', 'EMG RMS'}, ...
    'Location','northeast','Orientation','vertical','Box','off');

set([ax1, ax2, ax3], 'XTick', 1:floor(time_aligned(end)));

%% --- Report (Console)
fprintf('\n📊 Mean ± SD (over time) of Group-Averaged Waveforms:\n');
fprintf('Torque (Nm):     %.2f ± %.2f\n', group_torque_m, group_torque_s);
fprintf('Angle (°):       %.2f ± %.2f\n', group_angle_m, group_angle_s);
fprintf('EMG RMS (mV):    %.2f ± %.2f\n\n', group_emg_m, group_emg_s);

%% --- Save
saveFolder = uigetdir(folder, 'Select folder to save group mean');
if isequal(saveFolder, 0), return; end

savePath = fullfile(saveFolder, 'Group_MeanSingleRep.mat');
saveas(fig, fullfile(saveFolder, 'Group_MeanSingleRep.png'));

save(savePath, ...
    'time_aligned', 'torque_group', 'angle_group', 'emg_group', ...
    'torque_all', 'angle_all', 'emg_group_all', 'Fs', 'active_window');

fprintf('✅ Group mean saved to:\n📁 %s\n', savePath);
